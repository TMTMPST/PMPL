# E2E Testing Environment Configuration
# Copy this file to .env.test and update values as needed

# Base URL for the application
BASE_URL=http://localhost:8000

# JWT secret for API tokens (falls back to APP_KEY if omitted)
# JWT_SECRET=changeme123

# Admin credentials for testing (must match your seeder)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sipasti123

# Optional: Database connection for direct queries (if needed)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pmpl_test
# DB_USERNAME=root
# DB_PASSWORD=

# Optional: Test timeout (milliseconds)
# TEST_TIMEOUT=30000

# Optional: Headless mode
# HEADLESS=true

# Optional: Slow motion for debugging (milliseconds)
# SLOW_MO=100
